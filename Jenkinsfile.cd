// Parameterized CD pipeline.
// Deploys the artifact archived by a main-branch CI build. It never runs "npm run build".

pipeline {
    agent any

    parameters {
        string(
            name: 'CI_BUILD_NUMBER',
            defaultValue: '1',
            description: 'Build number of the main-branch CI job whose artifact will be deployed'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'TEST', 'ACC', 'PROD'],
            description: 'Target environment'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        // Full name of the CI Multibranch job's main branch: "<multibranch job>/<branch>".
        CI_MAIN_JOB = 'SQE-Final-Project-CI/main'
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    if (!(params.CI_BUILD_NUMBER ==~ /\d+/)) {
                        error('CI_BUILD_NUMBER must be a whole number, e.g. 12')
                    }
                    echo "=============================================="
                    echo "Selected CI build number : ${params.CI_BUILD_NUMBER}"
                    echo "Environment              : ${params.ENVIRONMENT}"
                    echo "This CD build number     : ${env.BUILD_NUMBER}"
                    echo "=============================================="
                }
            }
        }

        stage('Preflight') {
            steps {
                sh '''
                    if ! command -v docker >/dev/null 2>&1; then
                        echo "ERROR: the Docker CLI is not available inside the Jenkins container."
                        echo "Jenkins needs the docker CLI and /var/run/docker.sock mounted to deploy."
                        exit 1
                    fi
                    docker version --format 'Docker server version: {{.Server.Version}}'
                '''
            }
        }

        stage('Approve PROD') {
            when { expression { params.ENVIRONMENT == 'PROD' } }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input message: "Deploy CI build #${params.CI_BUILD_NUMBER} to PROD?", ok: 'Deploy'
                }
            }
        }

        stage('Retrieve Artifact') {
            steps {
                script {
                    env.ARTIFACT_FILE = "taskflow-${params.CI_BUILD_NUMBER}.tar.gz"
                }
                copyArtifacts(
                    projectName: env.CI_MAIN_JOB,
                    selector: specific(params.CI_BUILD_NUMBER),
                    filter: env.ARTIFACT_FILE,
                    fingerprintArtifacts: true
                )
            }
        }

        stage('Extract Artifact') {
            steps {
                sh '''
                    rm -rf deploy && mkdir deploy
                    tar -xzf "$ARTIFACT_FILE" -C deploy
                    ls -la deploy
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('deploy') {
                    // Uses the Dockerfile that was packaged inside the CI artifact.
                    sh "docker build -t taskflow:ci-${params.CI_BUILD_NUMBER} ."
                }
            }
        }

        stage('Deploy Container') {
            steps {
                script {
                    def ports = [DEV: '8081', TEST: '8082', ACC: '8083', PROD: '8084']
                    def port = ports[params.ENVIRONMENT]
                    def name = "taskflow-${params.ENVIRONMENT.toLowerCase()}"

                    sh """
                        docker rm -f ${name} || true
                        docker run -d --name ${name} -p ${port}:80 taskflow:ci-${params.CI_BUILD_NUMBER}
                    """

                    // Wait for the Dockerfile HEALTHCHECK to report healthy.
                    sh """
                        for i in \$(seq 1 15); do
                            status=\$(docker inspect --format '{{.State.Health.Status}}' ${name})
                            echo "health: \$status"
                            [ "\$status" = "healthy" ] && exit 0
                            sleep 2
                        done
                        docker logs ${name}
                        exit 1
                    """

                    echo "DEPLOYED CI build #${params.CI_BUILD_NUMBER} to ${params.ENVIRONMENT}: http://localhost:${port}"
                }
            }
        }
    }

    post {
        failure { echo 'CD failed. Check the stage that turned red.' }
    }
}
